<?php
// phpcs:ignoreFile
$click = function ($var, $collapse = false, $depth = 4) {
				return \Tracy\Dumper::toHtml($var, ['collapse' => $collapse, 'depth' => $depth]);
};

$esc = function ($s) {
	return htmlSpecialChars($s, ENT_QUOTES, 'UTF-8');
};

?>
    <style>
        #nette-debug .nette-elasticSearchPanel,
        #tracy-debug .nette-elasticSearchPanel { min-width: 100%; }
        #nette-debug .nette-elasticSearchPanel h2,
        #tracy-debug .nette-elasticSearchPanel h2 { font-size: 22px; font-weight: bold; }
        #nette-debug .nette-elasticSearchPanel small,
        #tracy-debug .nette-elasticSearchPanel small { font-size: 70%; font-weight: normal; }
        #nette-debug .nette-elasticSearchPanel code,
        #tracy-debug .nette-elasticSearchPanel code { font-size: 100%; font-weight: inherit; }
        #nette-debug .nette-elasticSearchPanel table,
        #tracy-debug .nette-elasticSearchPanel table { width: 100%; }
        #nette-debug .nette-elasticSearchPanel table.multiRequest,
        #tracy-debug .nette-elasticSearchPanel table.multiRequest { margin-top: 5px; }
        #nette-debug .nette-elasticSearchPanel table th,
        #tracy-debug .nette-elasticSearchPanel table th { text-align: right; }
    </style>

<?php foreach ($processedQueries as $host => $queries): ?>
    <h1 class="nette-elasticSearchPanel"><code><?php echo $esc($host) ?></code> - Queries: <?php echo $esc(count($queries)); ?>, time: <?php echo $esc($totalTime); ?> </h1>
    <div class="nette-inner tracy-inner nette-elasticSearchPanel">
		<?php foreach($queries as $query): ?>
			<?php
				/** @var \Psr\Http\Message\RequestInterface $request */
				$request = $query['request'];
				/** @var \Psr\Http\Message\ResponseInterface|null $response */
				$response = $query['response'];
				$time = $query['time'];
				$path = $request->getUri()->getPath();
				parse_str($request->getUri()->getQuery(), $requestQuery);
			?>
            <h2>
                <code><?php echo $esc(strtoupper($request->getMethod())); ?> <?php echo $esc('/' . ltrim($path, '/')); ?></code>
                <small><?php echo $esc(number_format($time * 1000, 2)); ?>ms</small>
            </h2>

            <table>
			<?php $requestData = $decode($request); if ($requestData !== null): ?>
                <tr>
                <th width="100"><a href="json:<?php echo $esc(\Nette\Utils\Json::encode($requestData)) ?>">Request:</th>
                <td><?php echo $click($requestData, TRUE, 25); ?></td>
                </tr>
            <?php endif; ?>

            <tr>
                <th width="100">Search type:</th>
                <td><?php echo isset($requestQuery[\Elastica\Search::OPTION_SEARCH_TYPE]) && is_string($requestQuery[\Elastica\Search::OPTION_SEARCH_TYPE]) ? $esc($requestQuery[\Elastica\Search::OPTION_SEARCH_TYPE]) : 'search' ?></td>
            </tr>

			<?php if ($response !== null && $response->getStatusCode() >= 200 && $response->getStatusCode() < 300) { $responsesData = $decode($response); ?>
				<?php $multiple = isset($responsesData['responses']); $responsesData = $multiple ? $responsesData['responses'] : array($responsesData); ?>

				<?php foreach ($responsesData as $index => $responseData) { ?>

					<?php if ($multiple) { ?>
                        </table>
                        <table class="multiRequest">
					<?php } ?>

					<?php if (stripos($path, '_search') !== FALSE || stripos($path, '_msearch') !== FALSE) { ?>
						<?php if (isset($responseData['took'])) { ?><tr>
                            <th width="100">Took:</th><td><?php echo $click($responseData['took']); ?></td>
                            </tr><?php } ?>

						<?php if (isset($responseData['timed_out']) && $responseData['timed_out']) { ?><tr>
                            <th width="100">Timed&nbsp;out:</th><td>yes</td>
                        </tr><?php } ?>

						<?php if (isset($responseData['_shards'])) { ?><tr>
                            <th width="100">Shards:</th><td>
                                total: <?php echo $esc($responseData['_shards']['total']); ?>,
                                successful: <?php echo $esc($responseData['_shards']['successful']); ?>,
                                failed: <?php echo $esc($responseData['_shards']['failed']); ?>
                            </td>
                            </tr><?php } ?>

						<?php if (isset($responseData['hits'])) { ?>
                            <?php if (isset($responseData['hits']['total'])) { ?>
                            <tr><th width="100">Total&nbsp;hits:</th><td><?php echo $click($responseData['hits']['total']); ?></td></tr>
                            <?php } ?>
                            <tr><th width="100">Max&nbsp;hit&nbsp;score:</th><td><?php echo $click($responseData['hits']['max_score']); ?></td></tr>
                            <tr><th width="100">Results:</th><td><?php echo $click($responseData['hits']['hits'], TRUE, 25); ?></td></tr>
						<?php } ?>

						<?php if (isset($responseData['aggregations'])) { ?>
                            <tr><th width="100">Aggregations:</th><td><?php echo $click($responseData['aggregations'], TRUE, 25); ?></td></tr>
						<?php } ?>

						<?php if (isset($responseData['error'])) { ?>
                            <tr>
                                <th width="100">Error:</th>
                                <td style="color:red"><?php echo is_string($responseData['error']) ? $esc($responseData['error']) : $click($responseData['error'], TRUE, 25); ?></td>
                            </tr>
						<?php } ?>

					<?php } else { ?>

                        <tr>
                            <th width="100">Response:</th>
                            <td><?php echo $click($responseData, TRUE, 25); ?></td>
                        </tr>

					<?php } ?>

				<?php } ?>

			<?php } elseif ($query['exception'] !== null) { ?>
                <tr>
                    <th width="100">Error:</th>
                    <td style="color:red"><?php echo $esc($query['exception']->getMessage()); ?></td>
                </tr>
			<?php } ?>

            </table>
		<?php endforeach; ?>
    </div>
<?php endforeach; ?>
